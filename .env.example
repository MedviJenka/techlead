APP_ENV=dev
API_VERSION=v1
# Required: the backend refuses to start without it.
OPENAI_MODEL=gpt-4o-mini
# Optional per-role models; both fall back to OPENAI_MODEL.
# AI_REASONING_MODEL=gpt-4o
# AI_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LOGFIRE_TOKEN=

# Log every SQL statement.
DB_ECHO=false
# Frontend origins allowed by CORS: a JSON list or a comma-separated string.
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database for `uv run pytest`. Read from the process environment (not this file).
# DESTRUCTIVE: the tests run `alembic downgrade base` and TRUNCATE on it - the name must end in `_test`.
# TEST_DATABASE_URL=postgresql+asyncpg://techlead:techlead@localhost:5433/techlead_test

SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required: the app's only database (postgresql://...). Migrations (`alembic upgrade head`) run against it too.
SUPABASE_SQL_CONNECT_STRING=
# Set to true only if SUPABASE_SQL_CONNECT_STRING is the transaction-mode pooler (port 6543).
DB_TRANSACTION_POOLER=false
