APP_ENV=dev
API_VERSION=v1
# Required: the backend refuses to start without it.
OPENAI_MODEL=gpt-4o-mini
# Optional per-role models; both fall back to OPENAI_MODEL.
# AI_REASONING_MODEL=gpt-4o
# AI_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional: USD per million tokens of the reasoning model, so each AI run's cost is recorded in dollars
# (token counts are always recorded). Check your provider's current prices.
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_CACHED_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
LOGFIRE_TOKEN=

# WhatsApp Cloud API (Meta app > WhatsApp > API Setup). The webhook is <backend>/api/v1/webhooks/whatsapp,
# subscribed to the `messages` field. Each business connects its number id in Settings.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_URL=http://localhost:8001   # local mock: uv run python -m app.api.v1.mock
# Optional: an approved template for approval requests when the owner has not written in the last 24 hours.
# WHATSAPP_APPROVAL_TEMPLATE=
# WHATSAPP_APPROVAL_TEMPLATE_LANGUAGE=en

# Frontend origins allowed by CORS: a JSON list or a comma-separated string.
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required: the app's database. Project URL and secret key from Supabase > Project Settings > API Keys.
# The secret key bypasses all access rules: keep it server-side, never in the frontend.
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Public key, given to the frontend for Google sign-in (it has no access to the tables).
SUPABASE_PUBLISHABLE_KEY=
# Optional: Supabase Auth public keys the backend verifies login tokens with (this is the default).
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# The Google OAuth client ID and secret go in Supabase > Authentication > Providers > Google, not here.

# For `uv run pytest`: a SEPARATE Supabase project used only for tests, with db/*.sql pasted into it.
# DESTRUCTIVE: the tests delete every row in it. pytest refuses the app's own project.
# TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
# TEST_SUPABASE_SECRET_KEY=
# Optional: its publishable key, to test that the public key cannot read or write the tables.
# TEST_SUPABASE_PUBLISHABLE_KEY=

# Optional: per-agent CrewAI memory, one per business+crew+agent, kept in a PRIVATE Supabase Storage bucket.
# Unset AI_MEMORY_BUCKET turns memory off. Keys from Supabase > Storage > S3 Connection. Run ONE backend replica.
# AI_MEMORY_BUCKET=agent-memory
# SUPABASE_S3_STORAGE=https://<ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_REGION=
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# AI_MEMORY_CACHE_DIR=.ai_memory
