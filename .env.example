APP_ENV=dev
API_VERSION=v1
# Required: the backend refuses to start without it.
OPENAI_MODEL=gpt-4o-mini
# Optional per-role models; both fall back to OPENAI_MODEL.
# AI_REASONING_MODEL=gpt-4o
# AI_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LOGFIRE_TOKEN=

# Frontend origins allowed by CORS: a JSON list or a comma-separated string.
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required: the app's database. Project URL and secret key from Supabase > Project Settings > API Keys.
# The secret key bypasses all access rules: keep it server-side, never in the frontend.
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Public key, given to the frontend for Google sign-in (it has no access to the tables).
SUPABASE_PUBLISHABLE_KEY=
# Optional: Supabase Auth public keys the backend verifies login tokens with (this is the default).
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# The Google OAuth client ID and secret go in Supabase > Authentication > Providers > Google, not here.

# For `uv run pytest`: a SEPARATE Supabase project used only for tests, with db/*.sql pasted into it.
# DESTRUCTIVE: the tests delete every row in it. pytest refuses the app's own project.
# TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
# TEST_SUPABASE_SECRET_KEY=
